{
  "datasets": [
    {
      "name": "41e2b9eb",
      "displayName": "hr_dataset",
      "config": {
        "version": "1.1",
        "source": "workspace.hr_attrition_analysis.hr_dataset",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "name": "Active Employee",
            "expr": "SUM(CASE\r\n  WHEN Attrition = 'No' THEN 1\r\n  ELSE 0\r\n  END)",
            "comment": "Total Active Emp in Company",
            "displayName": "Active Employee"
          },
          {
            "name": "Attrition Count",
            "expr": "SUM(CASE\r\n  WHEN attrition = 'Yes' THEN 1\r\n  ELSE 0\r\n  END)",
            "comment": "Employee who are not in Company.",
            "displayName": "Attrition Count"
          },
          {
            "name": "AVG Employee Age",
            "expr": "AVG(Age)",
            "comment": "Average Employee Age",
            "displayName": "AVG Employee Age"
          },
          {
            "name": "Attrition Rate (%)",
            "expr": "MEASURE(`Attrition Count`)/MEASURE(count)",
            "displayName": "Attrition Rate (%)"
          }
        ]
      }
    }
  ],
